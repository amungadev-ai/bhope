NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
TRUST_PROXY=0

# SQLite makes local setup work immediately (needs Node 22.13+). Use mysql
# on shared hosting (works on Node 18+) — see docs/DIRECTADMIN.md.
DB_DRIVER=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jobready_bhope_db
DB_USER=jobready_bhope_db_admin
DB_PASSWORD=
DB_POOL_SIZE=5
# Optional: MariaDB UNIX socket path when the host exposes no TCP port,
# e.g. /var/lib/mysql/mysql.sock (check phpMyAdmin home page).
DB_SOCKET=
# Optional: where the SQLite file lives (default: .local/api.sqlite inside
# apps/api when developing, inside the app root when deployed).
DB_SQLITE_PATH=

ALLOW_REGISTRATION=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AI_DAILY_LIMIT=10

# Optional HTTPS donation page. No payment processing is enabled by default.
DONATION_URL=
TIKTOK_URL=https://www.tiktok.com/@auramultipurposesoap

# Giving remains unavailable until credentials and an HTTPS APP_URL are configured.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
